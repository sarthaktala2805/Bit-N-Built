rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User Isolation Boundary:
    // Only an authenticated user whose UID matches {userId} can read, create, update, or delete
    // any document under their personal path: /users/{userId}/...
    // User A can NEVER access User B's documents.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny all access to any document outside the defined user schema
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

