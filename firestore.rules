rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User Isolation Boundary:
    // Only an authenticated user whose UID matches {userId} can read, create, update, or delete
    // any document under their personal path: /users/{userId}/...
    // User A can NEVER access User B's documents.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public Audience Events Directory:
    // Anyone (including unauthenticated attendees) can read event records by their 6-character access code.
    // Organizers can publish and update public events.
    match /public_events/{accessCode} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny all access to any document outside the defined schemas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
