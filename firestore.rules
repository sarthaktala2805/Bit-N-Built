rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User Isolation Boundary:
    // Only an authenticated user whose UID matches {userId} can read, create, update, or delete
    // any document under their personal path: /users/{userId}/...
    // User A can NEVER access User B's documents.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Global Public Events Directory:
    // Event Code is the global document ID: publicEvents/{eventCode}
    // Anyone (including guest/unauthenticated audience) can read if publicEnabled is true.
    match /publicEvents/{eventCode} {
      allow read: if resource == null || resource.data.publicEnabled == true;

      // Only the authenticated organizer matching ownerUserId can publish or modify
      allow create: if request.auth != null 
                    && request.resource.data.ownerUserId == request.auth.uid;

      allow update: if request.auth != null 
                    && resource.data.ownerUserId == request.auth.uid
                    && request.resource.data.ownerUserId == request.auth.uid;

      allow delete: if request.auth != null 
                    && resource.data.ownerUserId == request.auth.uid;

      // Audience Presence Subcollection:
      // Real-time active attendees reporting presence for this event
      match /presence/{sessionId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }
    }

    // Backwards-compatible legacy public_events collection:
    match /public_events/{accessCode} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny all access to any document outside the defined schemas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
