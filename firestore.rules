rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── 1. USER PRIVATE BOUNDARY (ORGANIZER DATA ISOLATION) ──
    // Every organizer's personal data is strictly isolated to their own UID.
    // Account B can NEVER read, create, update, or delete Account A's private documents.
    match /users/{userId}/{document=**} {
      allow read, write: if isUser(userId);
    }

    // ── 2. GLOBAL PUBLIC EVENTS DIRECTORY ──
    // Dedicated directory: publicEvents/{eventCode}
    match /publicEvents/{eventCode} {

      // [Requirement 1 & 2]: Public lookup works cross-account, but ONLY if publicEnabled is true (or owner)
      // Least-privilege: allow get (single document by code), deny list (prevents scraping all codes).
      allow get: if (resource.data.publicEnabled == true)
                 || (isAuthenticated() && resource.data.ownerUserId == request.auth.uid);
      allow list: if false;

      // [Requirement 3 & 7]: Only the authenticated event owner can create the public entry.
      // Enforces matching ownerUserId to auth UID, and eventCode to document ID.
      allow create: if isAuthenticated()
                    && request.resource.data.ownerUserId == request.auth.uid
                    && request.resource.data.eventCode == eventCode
                    && request.resource.data.eventId is string;

      // [Requirement 3, 4, 7 & 10]: Account B CANNOT modify Account A's public event.
      // Only the true owner can update.
      // Immutable fields: ownerUserId, eventId, and eventCode cannot be changed (anti-hijacking).
      allow update: if isAuthenticated()
                    && resource.data.ownerUserId == request.auth.uid
                    && request.resource.data.ownerUserId == resource.data.ownerUserId
                    && request.resource.data.eventId == resource.data.eventId
                    && request.resource.data.eventCode == resource.data.eventCode;

      // [Requirement 3 & 4]: Only the true owner can delete. Account B CANNOT delete Account A's event.
      allow delete: if isAuthenticated()
                    && resource.data.ownerUserId == request.auth.uid;

      // ── 3. AUDIENCE PRESENCE TRACKING (LEAST-PRIVILEGE SECURED) ──
      // Tracks active attendees under publicEvents/{eventCode}/presence/{sessionId}
      match /presence/{sessionId} {
        // [Privacy & Security]: Deny public collection listing and broad reads.
        // Individual session document can only be read by its authenticated owner or the event organizer.
        allow get: if isAuthenticated() && (
                     resource.data.userUid == request.auth.uid
                     || resource.data.ownerUserId == request.auth.uid
                   );
        allow list: if false;

        // [Authenticated Presence & Anti-Inflation]:
        // 1. Authenticated user can create only their own session where sessionId == request.auth.uid.
        //    Restricting sessionId to the user's UID enforces exactly 1 session per user (prevents count inflation).
        // 2. Unauthenticated/anonymous direct client writes are DENIED in Firestore rules
        //    (anonymous presence is handled through the cryptographically-signed server-side API).
        allow create: if isAuthenticated()
                      && request.auth.uid == sessionId
                      && request.resource.data.userUid == request.auth.uid
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.eventCode == eventCode
                      && request.resource.data.status == "active"
                      && request.resource.data.joinedAt is number
                      && request.resource.data.lastSeenAt is number;

        // [Session Hijacking Prevention & Immutability]:
        // 1. Authenticated user can update only their own session (Account B cannot touch Account A's session).
        // 2. Identities are IMMUTABLE: sessionId, eventCode, userUid, joinedAt cannot be modified.
        // 3. Status can only transition between "active" and "left".
        allow update: if isAuthenticated()
                      && resource.data.userUid == request.auth.uid
                      && request.resource.data.userUid == resource.data.userUid
                      && request.resource.data.sessionId == resource.data.sessionId
                      && request.resource.data.eventCode == resource.data.eventCode
                      && request.resource.data.joinedAt == resource.data.joinedAt
                      && (request.resource.data.status in ["active", "left"]);

        // Deletion forbidden (preserves session integrity and audit trail):
        allow delete: if false;
      }
    }

    // ── 4. BACKWARD COMPATIBILITY ──
    match /public_events/{accessCode} {
      allow get: if (resource.data.publicEnabled == true)
                 || (isAuthenticated() && resource.data.ownerUserId == request.auth.uid);
      allow list: if false;
      allow create: if isAuthenticated() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerUserId == request.auth.uid
                    && request.resource.data.ownerUserId == resource.data.ownerUserId;
      allow delete: if isAuthenticated() && resource.data.ownerUserId == request.auth.uid;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
